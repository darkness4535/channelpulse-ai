CURSOR_API_KEY=
COMPANY_MODEL=composer-2.5
COMPANY_CWD=

# 1 = локальный mock (как флаг --mock), без Cursor API
COMPANY_MOCK=

# 1 = автономия: автонайм + без вопросов (по умолчанию включено)
COMPANY_AUTONOMOUS=1

# Параллельных агентов в одной волне
COMPANY_PARALLEL_WORKERS=6

# Интервал daemon (часы)
COMPANY_INTERVAL_HOURS=24
